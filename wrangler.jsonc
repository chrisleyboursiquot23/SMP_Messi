{
  "name": "rdv-smp",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Anonymous visitor stats (dashboard at /stats.html). Created automatically on deploy.
  "d1_databases": [{ "binding": "STATS", "database_name": "rdv-smp-stats" }]
}
